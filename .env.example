# Postgres database for LangGraph's checkpointer (for example a free Neon database).
# Use the direct connection string, not the pooled one.
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# LLMs: Claude Haiku is the main model, Gemini is the fallback
GOOGLE_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Tools
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_API_KEY=your_serpapi_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional — LangSmith tracing. Set LANGSMITH_TRACING=false to disable
# tracing entirely and omit the rest of these safely.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Waypoint